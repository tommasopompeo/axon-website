# ─────────────────────────────────────────────────────────────────
# AXON WEBSITE — variabili d'ambiente
# Copia questo file in .env.local e compila i valori reali.
# .env.local NON va mai committato (già in .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── Shopify — URL pagine prodotto (redirect esterno, no checkout interno)
# Ottenere da: Shopify Admin → Prodotti → condividi link
NEXT_PUBLIC_SHOPIFY_KIT_URL=https://YOUR-STORE.myshopify.com/products/axon-kit
NEXT_PUBLIC_SHOPIFY_SHELL_URL=https://YOUR-STORE.myshopify.com/products/axon-shell

# ── Form contatti + aziende — endpoint del servizio di invio email
# Opzione A — Web3Forms: https://web3forms.com  →  access key
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR-WEB3FORMS-ACCESS-KEY

# Opzione B — Formspree: https://formspree.io  →  form ID
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR-FORM-ID

# Opzione C — API route interna + Resend (richiede anche RESEND_API_KEY)
# NEXT_PUBLIC_FORM_ENDPOINT=/api/contact
# RESEND_API_KEY=re_YOUR-RESEND-API-KEY
# CONTACT_EMAIL=info@axon-tech.it

# ── Social (opzionale — se si vuole gestire da env invece di lib/links.ts)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/axon_tech/
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@axon_tech
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/axon-tech
